# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.pytest_cache/
.ipynb_checkpoints/

# offline dependency bundle (hundreds of MB of third-party wheels, platform
# specific; rebuild with `python scripts/fetch_wheels.py` — see docs/OFFLINE_INSTALL.md)
vendor/

# gottlux outputs & caches (regenerable, often large)
_gottlux_cache/
gottlux_runs/
*_kpi_*/
kpi_comparison/
examples/quickstart_out/
examples/_smoke_figs/
examples/_run_test/

# documents (keep binary documents out of the repo)
*.docx

# local agent/editor config
.claude/

# event data (large; keep out of the repo) — EXCEPT the curated sample clips
*.raw
!examples/data/*.raw
!web/data/*.raw
!web/selftest/*.raw
*.hdf5
*.h5
!tests/data/*.h5
*.bin

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/
